# API
APP_ENV=development
# Local-only test sign-in. Set TEST_MODE=true to enable password 12345678.
TEST_MODE=false
TEST_PASSWORD=12345678
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
POSTGRES_DB=zetech_learning
POSTGRES_USER=zetech
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgresql+psycopg://zetech:local-only-change-me@127.0.0.1:5432/zetech_learning
CLIENT_ORIGINS=*
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Email sender (SMTP). Use an app password or a transactional email account.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Zetech Learning
SMTP_USE_TLS=true

# Product price: whole KES, configured on the server and never accepted from the client.
APP_PRICE_KES=100

# Safaricom Daraja. For a Buy Goods till, BusinessShortCode is the store/head-office
# shortcode linked to Daraja; MPESA_TILL_NUMBER is the customer-facing till (PartyB).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_BUSINESS_SHORTCODE=
MPESA_TILL_NUMBER=
MPESA_CALLBACK_URL=https://api.example.com/api/payments/mpesa/callback
MPESA_TIMEOUT_SECONDS=20
