# This file is copied to .env on the server. Keep .env private (chmod 600).
APP_ENV=production
TEST_MODE=false
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Dedicated MariaDB database in the isolated research-api container.
MARIADB_DATABASE=ictdev_api
MARIADB_USER=ictdev_api
MARIADB_PASSWORD=GENERATE_A_LONG_RANDOM_PASSWORD
MARIADB_ROOT_PASSWORD=GENERATE_ANOTHER_LONG_RANDOM_PASSWORD

API_HOST=api.ictdev.co.ke
CLIENT_ORIGINS=*
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
APP_PRICE_KES=100

# Email sender: update these values on the server after deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Codility Pro 254
SMTP_USE_TLS=true

# Safaricom Daraja: keep sandbox until production go-live is approved.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_BUSINESS_SHORTCODE=
MPESA_TILL_NUMBER=
MPESA_CALLBACK_URL=https://api.ictdev.co.ke/api/payments/mpesa/callback
MPESA_TIMEOUT_SECONDS=20
